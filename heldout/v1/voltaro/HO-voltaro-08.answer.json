{
  "id": "HO-voltaro-08",
  "customer": "voltaro",
  "language": "en",
  "subject": "Ultra-fast charging hub at a motorway service area",
  "requirements": [
    {"text": "Each charging station shall provide two charge points.", "doc": "spec", "kind": "charge_points", "value": 2, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The charging power per charge point shall be at least 480 kW in order to serve the next generation of 800 V vehicles.", "doc": "spec", "kind": "charging_power_kw", "value": 480, "unit": "kW", "priority": "mandatory", "verdict": "deviate", "severity": "knockout", "red_flag": true, "norms": []},
    {"text": "The output voltage shall range from 150 V to 1000 V.", "doc": "spec", "kind": "output_voltage_v", "value": [150, 1000], "unit": "V", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The maximum output current shall be at least 600 A.", "doc": "spec", "kind": "max_current_a", "value": 600, "unit": "A", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Charging stations must be rated at least IP54.", "doc": "spec", "kind": "ip_rating", "value": 54, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Operation should be possible between -30 °C and +50 °C.", "doc": "spec", "kind": "ambient_temperature", "value": [-30, 50], "unit": "°C", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The stations must comply with German calibration law (Eichrecht).", "doc": "spec", "kind": "calibration_law", "value": true, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ad hoc payment by debit and credit card shall be possible at every station.", "doc": "spec", "kind": "adhoc_payment", "value": true, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The stations shall support OCPP 2.0.1.", "doc": "spec", "kind": "ocpp_version", "value": "2.0.1", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Plug & Charge according to ISO 15118-2 should be supported.", "doc": "spec", "kind": "iso15118_part", "value": "2", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["ISO 15118-2"]},
    {"text": "Availability of each charge point shall be at least 98 %.", "doc": "spec", "kind": "availability_percent", "value": 98, "unit": "%", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Efficiency should be at least 96 %.", "doc": "spec", "kind": "efficiency_percent", "value": 96, "unit": "%", "priority": "desirable", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "The service response time should not exceed 6 hours.", "doc": "spec", "kind": "service_response_hours", "value": 6, "unit": "h", "priority": "desirable", "verdict": "deviate", "severity": "minor", "red_flag": true, "norms": []},
    {"text": "The stations shall be certified to IEC 61851-23.", "doc": "spec", "kind": "norm", "value": "IEC 61851-23", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 61851-23"]},
    {"text": "Conformity with PTB-A 50.7 is required.", "doc": "spec", "kind": "norm", "value": "PTB-A 50.7", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["PTB-A 50.7"]},
    {"text": "Electromagnetic immunity should comply with EN 61000-6-2.", "doc": "spec", "kind": "norm", "value": "EN 61000-6-2", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 61000-6-2"]},
    {"text": "All stations shall be delivered within six months of contract award.", "doc": "spec", "kind": "delivery_weeks", "value": 26, "unit": "weeks", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "A warranty of 60 months is required.", "doc": "spec", "kind": "warranty_months", "value": 60, "unit": "months", "priority": "mandatory", "verdict": "clarify", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Delay penalties shall not exceed 10 % of the contract value.", "doc": "spec", "kind": "penalty_cap_percent", "value": 10, "unit": "%", "priority": "mandatory", "verdict": "clarify", "severity": "major", "red_flag": true, "norms": []},
    {"text": "The supplier's liability is capped at twice the contract value.", "doc": "spec", "kind": "liability", "value": "double_contract_value", "unit": null, "priority": "mandatory", "verdict": "clarify", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Payment shall be made within 30 days.", "doc": "spec", "kind": "payment_days", "value": 30, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Documentation shall be provided in German.", "doc": "spec", "kind": "documentation_language", "value": "de", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Tenders shall be submitted by 1 March 2027 via the procurement platform.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Bidders shall provide references for at least three charging hubs with a total power of more than 2 MW each.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Tenders must remain valid for 90 days.", "doc": "spec", "kind": "bid_validity_days", "value": 90, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []}
  ],
  "norms": {"ISO 15118-2": "certified", "IEC 61851-23": "certified", "PTB-A 50.7": "certified", "EN 61000-6-2": "certified"},
  "bid": "no_bid",
  "variant": null
}
