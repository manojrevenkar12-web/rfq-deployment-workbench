{
  "id": "HO-voltaro-05",
  "customer": "voltaro",
  "language": "en",
  "subject": "Rapid chargers for the municipal vehicle fleet",
  "requirements": [
    {"text": "Each charging station shall have two charge points.", "doc": "spec", "kind": "charge_points", "value": 2, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "A charging power of 240 kW per charge point is required.", "doc": "spec", "kind": "charging_power_kw", "value": 240, "unit": "kW", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The chargers must support output voltages from 200 V to 1000 V.", "doc": "spec", "kind": "output_voltage_v", "value": [200, 1000], "unit": "V", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Maximum current shall be at least 400 A.", "doc": "spec", "kind": "max_current_a", "value": 400, "unit": "A", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The enclosure shall be rated IP55.", "doc": "spec", "kind": "ip_rating", "value": 55, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The operating temperature range shall be at least -25 °C to +45 °C.", "doc": "spec", "kind": "ambient_temperature", "value": [-25, 45], "unit": "°C", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The chargers must communicate with the municipal back office via OCPP 2.1.", "doc": "spec", "kind": "ocpp_version", "value": "2.1", "unit": null, "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "ISO 15118-2 shall be supported for Plug & Charge.", "doc": "spec", "kind": "iso15118_part", "value": "2", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["ISO 15118-2"]},
    {"text": "Card payment at the charger is desirable for occasional use by visitors.", "doc": "spec", "kind": "adhoc_payment", "value": true, "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The efficiency should be at least 95 %.", "doc": "spec", "kind": "efficiency_percent", "value": 95, "unit": "%", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "An availability of 97 % per year shall be guaranteed.", "doc": "spec", "kind": "availability_percent", "value": 97, "unit": "%", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The supplier's service technicians shall respond on site within 24 hours.", "doc": "spec", "kind": "service_response_hours", "value": 24, "unit": "h", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Cable length should be at least 6 m.", "doc": "spec", "kind": "cable_length_m", "value": 6, "unit": "m", "priority": "desirable", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "The chargers shall comply with IEC 61851-1.", "doc": "spec", "kind": "norm", "value": "IEC 61851-1", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 61851-1"]},
    {"text": "Conformity with IEC 61851-23 is mandatory.", "doc": "spec", "kind": "norm", "value": "IEC 61851-23", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 61851-23"]},
    {"text": "Impact resistance should be at least IK10 according to IEC 62262.", "doc": "spec", "kind": "norm", "value": "IEC 62262", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 62262"]},
    {"text": "Delivery shall take place within 16 weeks of the order.", "doc": "spec", "kind": "delivery_weeks", "value": 16, "unit": "weeks", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The warranty period shall be 24 months.", "doc": "spec", "kind": "warranty_months", "value": 24, "unit": "months", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Penalties for late delivery are capped at 5 % of the contract value.", "doc": "spec", "kind": "penalty_cap_percent", "value": 5, "unit": "%", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Invoices will be paid within 60 days.", "doc": "spec", "kind": "payment_days", "value": 60, "unit": "days", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Liability shall be limited to the contract value.", "doc": "spec", "kind": "liability", "value": "contract_value", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Documentation must be provided in English.", "doc": "spec", "kind": "documentation_language", "value": "en", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Spare parts should be available for at least 8 years after commissioning.", "doc": "spec", "kind": "spare_parts_years", "value": 8, "unit": "years", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Tenders must be submitted through the municipality's e-procurement platform by 17 February 2027, 14:00.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Bidders must demonstrate at least three comparable fleet charging projects.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Proof of professional liability insurance shall be enclosed.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []}
  ],
  "norms": {"ISO 15118-2": "certified", "IEC 61851-1": "certified", "IEC 61851-23": "certified", "IEC 62262": "certified"},
  "bid": "bid",
  "variant": "VOLT 240"
}
