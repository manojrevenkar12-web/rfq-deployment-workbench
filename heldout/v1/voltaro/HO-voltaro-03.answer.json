{
  "id": "HO-voltaro-03",
  "customer": "voltaro",
  "language": "de",
  "subject": "Schnellladeinfrastruktur an Autobahn-Rastanlagen",
  "requirements": [
    {"text": "Je Ladestation sind vier Ladepunkte vorzusehen, die gleichzeitig betrieben werden können.", "doc": "spec", "kind": "charge_points", "value": 4, "unit": null, "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Jeder Ladepunkt muss eine Ladeleistung von 350 kW bereitstellen.", "doc": "spec", "kind": "charging_power_kw", "value": 350, "unit": "kW", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Spannungsbereich am Ausgang hat 150 V bis 1.000 V zu umfassen.", "doc": "spec", "kind": "output_voltage_v", "value": [150, 1000], "unit": "V", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ein Ladestrom von bis zu 500 A sollte möglich sein.", "doc": "spec", "kind": "max_current_a", "value": 500, "unit": "A", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Stationen müssen bei Außentemperaturen von -35 °C bis +45 °C betriebsfähig sein.", "doc": "spec", "kind": "ambient_temperature", "value": [-35, 45], "unit": "°C", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Schutzart soll mindestens IP55 betragen.", "doc": "spec", "kind": "ip_rating", "value": 55, "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Ladestationen müssen eichrechtskonform sein.", "doc": "spec", "kind": "calibration_law", "value": true, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ein Kartenterminal für das kontaktlose Ad-hoc-Laden ist in jede Ladestation zu integrieren.", "doc": "spec", "kind": "adhoc_payment", "value": true, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Für die Backend-Anbindung sollte OCPP 2.0.1 unterstützt werden.", "doc": "spec", "kind": "ocpp_version", "value": "2.0.1", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Jeder Ladepunkt muss eine zeitliche Verfügbarkeit von mindestens 99 % erreichen.", "doc": "spec", "kind": "availability_percent", "value": 99, "unit": "%", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Die Reaktionszeit des Service bei Störungen darf acht Stunden nicht überschreiten.", "doc": "spec", "kind": "service_response_hours", "value": 8, "unit": "h", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Kabellänge sollte mindestens 5 m betragen.", "doc": "spec", "kind": "cable_length_m", "value": 5, "unit": "m", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Wirkungsgrad sollte mindestens 95 % erreichen.", "doc": "spec", "kind": "efficiency_percent", "value": 95, "unit": "%", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Konformität mit IEC 61851-23 ist nachzuweisen.", "doc": "spec", "kind": "norm", "value": "IEC 61851-23", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 61851-23"]},
    {"text": "Die Anforderungen der PTB-A 50.7 an eichrechtskonforme Ladeeinrichtungen sind einzuhalten.", "doc": "spec", "kind": "norm", "value": "PTB-A 50.7", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["PTB-A 50.7"]},
    {"text": "Der Anschluss an das Mittelspannungsnetz hat nach VDE-AR-N 4110 zu erfolgen.", "doc": "spec", "kind": "norm", "value": "VDE-AR-N 4110", "unit": null, "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": ["VDE-AR-N 4110"]},
    {"text": "Die Schutzart der Gehäuse sollte nach IEC 60529 geprüft sein.", "doc": "spec", "kind": "norm", "value": "IEC 60529", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 60529"]},
    {"text": "Die Lieferung der Ladestationen erfolgt spätestens vier Monate nach Zuschlag.", "doc": "spec", "kind": "delivery_weeks", "value": 17.3, "unit": "weeks", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Gewährleistung beträgt 48 Monate.", "doc": "spec", "kind": "warranty_months", "value": 48, "unit": "months", "priority": "mandatory", "verdict": "clarify", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Die Vertragsstrafe bei Überschreitung der Inbetriebnahmetermine beträgt 0,2 % je Kalendertag, gedeckelt auf 7,5 % des Auftragswerts.", "doc": "spec", "kind": "penalty_cap_percent", "value": 7.5, "unit": "%", "priority": "mandatory", "verdict": "clarify", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Die Haftung des Auftragnehmers wird auf die Auftragssumme begrenzt.", "doc": "spec", "kind": "liability", "value": "contract_value", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Zahlungsziel sind 30 Tage.", "doc": "spec", "kind": "payment_days", "value": 30, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Dokumentation ist in deutscher Sprache bereitzustellen.", "doc": "spec", "kind": "documentation_language", "value": "de", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Das Angebot ist bis zum 05.02.2027 um 12:00 Uhr elektronisch einzureichen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Bieter hat eine Haftpflichtversicherung mit einer Deckungssumme von mindestens 10 Mio. EUR nachzuweisen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Referenzen über mindestens fünf errichtete HPC-Standorte an Fernstraßen sind beizufügen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []}
  ],
  "norms": {"IEC 61851-23": "certified", "PTB-A 50.7": "certified", "VDE-AR-N 4110": "not_certified", "IEC 60529": "certified"},
  "bid": "bid",
  "variant": "VOLT 400"
}
