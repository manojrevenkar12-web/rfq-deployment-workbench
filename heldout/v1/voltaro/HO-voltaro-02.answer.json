{
  "id": "HO-voltaro-02",
  "customer": "voltaro",
  "language": "en",
  "subject": "DC charging infrastructure for an electric van depot",
  "requirements": [
    {"text": "Each charger shall provide two charge points.", "doc": "spec", "kind": "charge_points", "value": 2, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The charging power per charge point shall be at least 150 kW.", "doc": "spec", "kind": "charging_power_kw", "value": 150, "unit": "kW", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The output voltage range must cover 150 V to 920 V.", "doc": "spec", "kind": "output_voltage_v", "value": [150, 920], "unit": "V", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The maximum output current per charge point should be not less than 250 A.", "doc": "spec", "kind": "max_current_a", "value": 250, "unit": "A", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Peak efficiency must be at least 96 %.", "doc": "spec", "kind": "efficiency_percent", "value": 96, "unit": "%", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "The chargers must have an ingress protection rating of at least IP55.", "doc": "spec", "kind": "ip_rating", "value": 55, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Chargers should operate between -20 °C and +40 °C.", "doc": "spec", "kind": "ambient_temperature", "value": [-20, 40], "unit": "°C", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Communication with the fleet management system shall use OCPP 1.6J.", "doc": "spec", "kind": "ocpp_version", "value": "1.6J", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Support for Plug & Charge according to ISO 15118-20 is required.", "doc": "spec", "kind": "iso15118_part", "value": "20", "unit": null, "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": ["ISO 15118-20"]},
    {"text": "Charging cables should be 7.5 m long so that they reach vans parked nose-in.", "doc": "spec", "kind": "cable_length_m", "value": 7.5, "unit": "m", "priority": "desirable", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Charger availability should be at least 97 %.", "doc": "spec", "kind": "availability_percent", "value": 97, "unit": "%", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "In the event of a fault, a service technician must be on site within 4 hours.", "doc": "spec", "kind": "service_response_hours", "value": 4, "unit": "h", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "The chargers shall be certified to IEC 61851-23.", "doc": "spec", "kind": "norm", "value": "IEC 61851-23", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 61851-23"]},
    {"text": "Connectors must comply with IEC 62196-3.", "doc": "spec", "kind": "norm", "value": "IEC 62196-3", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 62196-3"]},
    {"text": "Emission limits according to EN 61000-6-4 should be met.", "doc": "spec", "kind": "norm", "value": "EN 61000-6-4", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 61000-6-4"]},
    {"text": "Delivery and commissioning shall be completed within 14 weeks of the purchase order.", "doc": "spec", "kind": "delivery_weeks", "value": 14, "unit": "weeks", "priority": "mandatory", "verdict": "clarify", "severity": "major", "red_flag": true, "norms": []},
    {"text": "A warranty of 36 months is required.", "doc": "spec", "kind": "warranty_months", "value": 36, "unit": "months", "priority": "mandatory", "verdict": "clarify", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Late delivery penalties are 1 % of the order value per week, capped at 5 %.", "doc": "spec", "kind": "penalty_cap_percent", "value": 5, "unit": "%", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Payment term: 45 days after invoice date.", "doc": "spec", "kind": "payment_days", "value": 45, "unit": "days", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Liability is limited to EUR 1 million per event.", "doc": "spec", "kind": "liability", "value": "limited", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Training of two days for depot staff should be included.", "doc": "spec", "kind": "training_days", "value": 2, "unit": "days", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Documentation shall be provided in English.", "doc": "spec", "kind": "documentation_language", "value": "en", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Offers shall be sent by e-mail to the procurement team no later than 31 January 2027.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Bidders must provide references from at least two fleet depot installations.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Offers shall remain valid for 90 days.", "doc": "spec", "kind": "bid_validity_days", "value": 90, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []}
  ],
  "norms": {"ISO 15118-20": "not_certified", "IEC 61851-23": "certified", "IEC 62196-3": "certified", "EN 61000-6-4": "certified"},
  "bid": "bid",
  "variant": "VOLT 160"
}
