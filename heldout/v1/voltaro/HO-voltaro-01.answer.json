{
  "id": "HO-voltaro-01",
  "customer": "voltaro",
  "language": "de",
  "subject": "Lieferung und Errichtung von Schnellladestationen (HPC) im Stadtgebiet",
  "requirements": [
    {"text": "Jede Ladestation muss zwei Ladepunkte mit CCS-Ladekabel aufweisen.", "doc": "spec", "kind": "charge_points", "value": 2, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Ladeleistung je Ladepunkt muss mindestens 300 kW betragen.", "doc": "spec", "kind": "charging_power_kw", "value": 300, "unit": "kW", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Ausgangsspannungsbereich hat mindestens 200 V bis 920 V abzudecken.", "doc": "spec", "kind": "output_voltage_v", "value": [200, 920], "unit": "V", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der maximale Ladestrom je Ladepunkt muss mindestens 500 A betragen.", "doc": "spec", "kind": "max_current_a", "value": 500, "unit": "A", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Wirkungsgrad bei Nennleistung sollte mindestens 95 % betragen.", "doc": "spec", "kind": "efficiency_percent", "value": 95, "unit": "%", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Ladestation ist mindestens in Schutzart IP54 auszuführen.", "doc": "spec", "kind": "ip_rating", "value": 54, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Stationen sollen bei Umgebungstemperaturen von -25 °C bis +45 °C ohne Leistungsreduzierung betrieben werden können.", "doc": "spec", "kind": "ambient_temperature", "value": [-25, 45], "unit": "°C", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Anbindung an das Backend der Stadtwerke muss über OCPP 2.0.1 erfolgen.", "doc": "spec", "kind": "ocpp_version", "value": "2.0.1", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Ladestationen müssen dem deutschen Eichrecht entsprechen.", "doc": "spec", "kind": "calibration_law", "value": true, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ad-hoc-Laden mit Debit- und Kreditkarte muss an jeder Station über ein Kartenterminal möglich sein.", "doc": "spec", "kind": "adhoc_payment", "value": true, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Plug & Charge nach ISO 15118-2 sollte unterstützt werden.", "doc": "spec", "kind": "iso15118_part", "value": "2", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["ISO 15118-2"]},
    {"text": "Das Ladekabel sollte eine Länge von mindestens 5 m haben.", "doc": "spec", "kind": "cable_length_m", "value": 5, "unit": "m", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Verfügbarkeit jedes Ladepunkts sollte im Jahresmittel mindestens 97 % betragen.", "doc": "spec", "kind": "availability_percent", "value": 97, "unit": "%", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Servicetechniker muss spätestens 24 Stunden nach Störungsmeldung vor Ort sein.", "doc": "spec", "kind": "service_response_hours", "value": 24, "unit": "h", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Ladestationen müssen IEC 61851-23 entsprechen.", "doc": "spec", "kind": "norm", "value": "IEC 61851-23", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 61851-23"]},
    {"text": "Die Störfestigkeit sollte nach EN 61000-6-2 nachgewiesen werden.", "doc": "spec", "kind": "norm", "value": "EN 61000-6-2", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 61000-6-2"]},
    {"text": "Die Technischen Anschlussregeln Niederspannung (VDE-AR-N 4100) sind einzuhalten.", "doc": "spec", "kind": "norm", "value": "VDE-AR-N 4100", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["VDE-AR-N 4100"]},
    {"text": "Die Lieferung der ersten Station hat spätestens 20 Wochen nach Auftragserteilung zu erfolgen.", "doc": "spec", "kind": "delivery_weeks", "value": 20, "unit": "weeks", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Gewährleistung beträgt zwei Jahre ab Abnahme.", "doc": "spec", "kind": "warranty_months", "value": 24, "unit": "months", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Bei Lieferverzug ist eine Vertragsstrafe von 0,3 % des Auftragswerts je Werktag zu zahlen, höchstens jedoch 5 % des Auftragswerts.", "doc": "spec", "kind": "penalty_cap_percent", "value": 5, "unit": "%", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Zahlungen erfolgen innerhalb von 30 Tagen nach Rechnungseingang.", "doc": "spec", "kind": "payment_days", "value": 30, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Haftung ist auf die Auftragssumme begrenzt.", "doc": "spec", "kind": "liability", "value": "contract_value", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ersatzteile sollten für zehn Jahre verfügbar sein.", "doc": "spec", "kind": "spare_parts_years", "value": 10, "unit": "years", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Eine eintägige Schulung des Betriebspersonals ist in den Angebotspreis einzurechnen.", "doc": "spec", "kind": "training_days", "value": 1, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Angebote sind bis zum 20.01.2027, 10:00 Uhr, über das Vergabeportal einzureichen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Es sind mindestens drei Referenzen über in Deutschland errichtete HPC-Stationen mit mindestens 150 kW Ladeleistung vorzulegen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Angebotsbindefrist beträgt 60 Tage.", "doc": "spec", "kind": "bid_validity_days", "value": 60, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []}
  ],
  "norms": {"ISO 15118-2": "certified", "IEC 61851-23": "certified", "EN 61000-6-2": "certified", "VDE-AR-N 4100": "certified"},
  "bid": "bid",
  "variant": "VOLT 400"
}
