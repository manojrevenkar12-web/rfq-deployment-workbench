{
  "id": "HO-voltaro-07",
  "customer": "voltaro",
  "language": "de",
  "subject": "Depotladeinfrastruktur für Elektrobusse am Betriebshof Nord",
  "requirements": [
    {"text": "Jede Ladestation ist mit zwei Ladepunkten auszustatten.", "doc": "spec", "kind": "charge_points", "value": 2, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Ladeleistung je Ladepunkt muss mindestens 120 kW betragen.", "doc": "spec", "kind": "charging_power_kw", "value": 120, "unit": "kW", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Ausgangsspannungsbereich muss 150 V bis 850 V abdecken.", "doc": "spec", "kind": "output_voltage_v", "value": [150, 850], "unit": "V", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der maximale Strom je Ladepunkt muss mindestens 250 A betragen.", "doc": "spec", "kind": "max_current_a", "value": 250, "unit": "A", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ein Wirkungsgrad von mindestens 94 % sollte eingehalten werden.", "doc": "spec", "kind": "efficiency_percent", "value": 94, "unit": "%", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Schutzart der Ladestationen sollte mindestens IP54 betragen.", "doc": "spec", "kind": "ip_rating", "value": 54, "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Ladestationen sollen von -25 °C bis +40 °C betrieben werden können.", "doc": "spec", "kind": "ambient_temperature", "value": [-25, 40], "unit": "°C", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Anbindung an das Depotmanagementsystem hat über OCPP 2.0.1 zu erfolgen.", "doc": "spec", "kind": "ocpp_version", "value": "2.0.1", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Kommunikation zwischen Fahrzeug und Ladestation soll nach ISO 15118-20 erfolgen.", "doc": "spec", "kind": "iso15118_part", "value": "20", "unit": null, "priority": "desirable", "verdict": "clarify", "severity": null, "red_flag": false, "norms": ["ISO 15118-20"]},
    {"text": "Die Ladekabel müssen mindestens 7,5 m lang sein, da die Busse in Reihe aufgestellt werden.", "doc": "spec", "kind": "cable_length_m", "value": 7.5, "unit": "m", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die technische Verfügbarkeit muss mindestens 98 % betragen.", "doc": "spec", "kind": "availability_percent", "value": 98, "unit": "%", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Service muss bei Störungen innerhalb von 12 Stunden vor Ort sein.", "doc": "spec", "kind": "service_response_hours", "value": 12, "unit": "h", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Ladestationen müssen IEC 61851-23 erfüllen.", "doc": "spec", "kind": "norm", "value": "IEC 61851-23", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 61851-23"]},
    {"text": "Die Grenzwerte der EN 61000-6-4 für Störaussendungen sind einzuhalten.", "doc": "spec", "kind": "norm", "value": "EN 61000-6-4", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 61000-6-4"]},
    {"text": "Die Steckvorrichtungen sollen IEC 62196-3 entsprechen.", "doc": "spec", "kind": "norm", "value": "IEC 62196-3", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 62196-3"]},
    {"text": "Die Ladeinfrastruktur muss spätestens zehn Wochen nach Auftragserteilung betriebsbereit übergeben werden, da die ersten Busse im Mai 2027 ausgeliefert werden.", "doc": "spec", "kind": "delivery_weeks", "value": 10, "unit": "weeks", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Die Gewährleistungsfrist beträgt 24 Monate.", "doc": "spec", "kind": "warranty_months", "value": 24, "unit": "months", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Vertragsstrafe ist auf 5 % der Auftragssumme begrenzt.", "doc": "spec", "kind": "penalty_cap_percent", "value": 5, "unit": "%", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Haftung des Auftragnehmers ist nicht begrenzt.", "doc": "spec", "kind": "liability", "value": "unlimited", "unit": null, "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Zahlungen werden binnen 30 Tagen geleistet.", "doc": "spec", "kind": "payment_days", "value": 30, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Es sind zwei Schulungstage für das Werkstattpersonal vorzusehen.", "doc": "spec", "kind": "training_days", "value": 2, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ersatzteile sollen mindestens zehn Jahre verfügbar sein.", "doc": "spec", "kind": "spare_parts_years", "value": 10, "unit": "years", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Angebote sind bis zum 22.01.2027 einzureichen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Referenzen über mindestens zwei Depotladeprojekte für Busse sind vorzulegen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ein Nachweis der Betriebshaftpflichtversicherung ist beizufügen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []}
  ],
  "norms": {"ISO 15118-20": "not_certified", "IEC 61851-23": "certified", "EN 61000-6-4": "certified", "IEC 62196-3": "certified"},
  "bid": "bid",
  "variant": "VOLT 160"
}
