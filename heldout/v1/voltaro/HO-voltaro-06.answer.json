{
  "id": "HO-voltaro-06",
  "customer": "voltaro",
  "language": "de",
  "subject": "Rahmenvertrag über DC-Schnellladesäulen",
  "requirements": [
    {"text": "Jede Ladesäule muss zwei Ladepunkte haben.", "doc": "spec", "kind": "charge_points", "value": 2, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Ladeleistung je Ladepunkt beträgt mindestens 180 kW.", "doc": "spec", "kind": "charging_power_kw", "value": 180, "unit": "kW", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Ausgangsspannungsbereich muss 200 V bis 920 V umfassen.", "doc": "spec", "kind": "output_voltage_v", "value": [200, 920], "unit": "V", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der maximale Ausgangsstrom sollte mindestens 300 A betragen.", "doc": "spec", "kind": "max_current_a", "value": 300, "unit": "A", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Wegen der Hochwassergefahr an einzelnen Standorten wird die Schutzart IP65 gefordert.", "doc": "spec", "kind": "ip_rating", "value": 65, "unit": null, "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Die Ladesäulen sollen für Umgebungstemperaturen von -30 °C bis +50 °C ausgelegt sein.", "doc": "spec", "kind": "ambient_temperature", "value": [-30, 50], "unit": "°C", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Eichrechtskonformität ist zwingend.", "doc": "spec", "kind": "calibration_law", "value": true, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ein Kartenlesegerät für Ad-hoc-Zahlungen muss verbaut sein.", "doc": "spec", "kind": "adhoc_payment", "value": true, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Kommunikation mit dem Backend muss über OCPP 1.6J erfolgen.", "doc": "spec", "kind": "ocpp_version", "value": "1.6J", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ein späteres Update auf OCPP 2.0.1 sollte möglich sein.", "doc": "spec", "kind": "ocpp_version", "value": "2.0.1", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Plug & Charge gemäß ISO 15118-2 soll unterstützt werden.", "doc": "spec", "kind": "iso15118_part", "value": "2", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["ISO 15118-2"]},
    {"text": "Die Verfügbarkeit muss mindestens 97,5 % betragen.", "doc": "spec", "kind": "availability_percent", "value": 97.5, "unit": "%", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Ladekabel sollen 4 m lang sein.", "doc": "spec", "kind": "cable_length_m", "value": 4, "unit": "m", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Ladesäulen müssen nach IEC 61851-23 gebaut sein.", "doc": "spec", "kind": "norm", "value": "IEC 61851-23", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 61851-23"]},
    {"text": "Die Steckvorrichtungen haben der IEC 62196-3 zu entsprechen.", "doc": "spec", "kind": "norm", "value": "IEC 62196-3", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 62196-3"]},
    {"text": "Der Netzanschluss muss die VDE-AR-N 4100 erfüllen.", "doc": "spec", "kind": "norm", "value": "VDE-AR-N 4100", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["VDE-AR-N 4100"]},
    {"text": "Die Schutzart sollte durch eine Prüfung nach IEC 60529 belegt werden.", "doc": "spec", "kind": "norm", "value": "IEC 60529", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["IEC 60529"]},
    {"text": "Abrufe sind jeweils innerhalb von 16 Wochen zu liefern.", "doc": "spec", "kind": "delivery_weeks", "value": 16, "unit": "weeks", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Gewährleistung beträgt 24 Monate je Ladesäule.", "doc": "spec", "kind": "warranty_months", "value": 24, "unit": "months", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Für jeden Tag des Lieferverzugs wird eine Vertragsstrafe von 0,5 % des Abrufwerts fällig; eine Obergrenze ist nicht vorgesehen.", "doc": "spec", "kind": "penalty_cap_percent", "value": null, "unit": "%", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Die Zahlungsfrist beträgt 30 Tage.", "doc": "spec", "kind": "payment_days", "value": 30, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Haftung ist auf 500.000 EUR je Schadensfall begrenzt.", "doc": "spec", "kind": "liability", "value": "limited", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Schulung des Servicepersonals umfasst drei Tage.", "doc": "spec", "kind": "training_days", "value": 3, "unit": "days", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Dokumentation ist auf Deutsch zu liefern.", "doc": "spec", "kind": "documentation_language", "value": "de", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Das Angebot ist bis zum 08.02.2027, 09:00 Uhr, über die e-Vergabe einzureichen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Mit dem Angebot ist die Baumusterprüfbescheinigung zum Nachweis der Eichrechtskonformität vorzulegen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Bindefrist beträgt 120 Tage.", "doc": "spec", "kind": "bid_validity_days", "value": 120, "unit": "days", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []}
  ],
  "norms": {"ISO 15118-2": "certified", "IEC 61851-23": "certified", "IEC 62196-3": "certified", "VDE-AR-N 4100": "certified", "IEC 60529": "certified"},
  "bid": "bid",
