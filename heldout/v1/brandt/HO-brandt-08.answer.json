  "subject": "Hilfeleistungslöschgruppenfahrzeug HLF 20 für die Hauptwache",
  "requirements": [
    {"text": "Zu beschaffen ist ein HLF 20.", "doc": "spec", "kind": "vehicle_type", "value": "HLF 20", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die zulässige Gesamtmasse darf 16 t nicht überschreiten.", "doc": "spec", "kind": "gross_mass_t", "value": 16, "unit": "t", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Antrieb: Straßenfahrgestell 4x2 mit Differenzialsperre.", "doc": "spec", "kind": "drive", "value": "4x2", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Löschwasserbehälter muss mindestens 3.500 l fassen.", "doc": "spec", "kind": "water_tank_l", "value": 3500, "unit": "l", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Schaummittelbehälter soll 200 l fassen.", "doc": "spec", "kind": "foam_tank_l", "value": 200, "unit": "l", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Einzubauen ist eine Feuerlöschkreiselpumpe FPN 10-3000.", "doc": "spec", "kind": "fire_pump", "value": "FPN 10-3000", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Mannschaftskabine ist für 1+8 Einsatzkräfte auszulegen.", "doc": "spec", "kind": "crew_cab", "value": "1+8", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ein Stromerzeuger mit 14 kVA sollte vorgesehen werden.", "doc": "spec", "kind": "generator_kva", "value": 14, "unit": "kVA", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ein pneumatischer Lichtmast muss eingebaut werden.", "doc": "spec", "kind": "light_mast", "value": true, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Das Fahrzeug ist nach DIN 14530-27 auszuführen.", "doc": "spec", "kind": "norm", "value": "DIN 14530-27", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["DIN 14530-27"]},
    {"text": "Die Anforderungen der DIN EN 1846-2 sind zu erfüllen.", "doc": "spec", "kind": "norm", "value": "DIN EN 1846-2", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["DIN EN 1846-2"]},
    {"text": "Die Einhaltung der DIN 14502-3 ist wünschenswert.", "doc": "spec", "kind": "norm", "value": "DIN 14502-3", "unit": null, "priority": "desirable", "verdict": "deviate", "severity": "minor", "red_flag": true, "norms": ["DIN 14502-3"]},
    {"text": "Die Pumpe sollte nach DIN EN 1028-1 abgenommen werden.", "doc": "spec", "kind": "norm", "value": "DIN EN 1028-1", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["DIN EN 1028-1"]},
    {"text": "Das Fahrzeug ist spätestens 15 Monate nach Zuschlag auszuliefern.", "doc": "spec", "kind": "delivery_weeks", "value": 65, "unit": "weeks", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Die Gewährleistung für das Gesamtfahrzeug beträgt 48 Monate.", "doc": "spec", "kind": "warranty_months", "value": 48, "unit": "months", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Bei Lieferverzug ist eine Vertragsstrafe von 0,2 % je Werktag zu zahlen, höchstens 5 % der Netto-Auftragssumme.", "doc": "spec", "kind": "penalty_cap_percent", "value": 5, "unit": "%", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Zahlungsfrist beträgt 30 Tage.", "doc": "spec", "kind": "payment_days", "value": 30, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ersatzteile sollten für mindestens zehn Jahre lieferbar sein.", "doc": "spec", "kind": "spare_parts_years", "value": 10, "unit": "years", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Schulung des Personals sollte drei Tage an der Hauptwache umfassen.", "doc": "spec", "kind": "training_days", "value": 3, "unit": "days", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Haftung ist auf den Auftragswert begrenzt.", "doc": "spec", "kind": "liability", "value": "contract_value", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Angebote sind bis zum 09.02.2027, 10:00 Uhr, elektronisch einzureichen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Dem Angebot ist ein Nachweis über eine Betriebshaftpflichtversicherung beizufügen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Mit dem Angebot sind Referenzen von mindestens zwei Berufsfeuerwehren vorzulegen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []}
  ],
