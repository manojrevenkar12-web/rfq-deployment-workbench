{
  "id": "HO-gleiswerk-02",
  "customer": "gleiswerk",
  "language": "en",
  "subject": "Supply of a rail grinding train",
  "requirements": [
    {"text": "The grinding train shall be designed for a track gauge of 1435 mm.", "doc": "spec", "kind": "track_gauge_mm", "value": 1435, "unit": "mm", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The axle load must not exceed 22.5 t at any point of the train.", "doc": "spec", "kind": "axle_load_t", "value": 22.5, "unit": "t", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "A minimum travel speed of 100 km/h in self-propelled transfer mode is required.", "doc": "spec", "kind": "travel_speed_kmh", "value": 100, "unit": "km/h", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The total installed engine power shall be at least 700 kW.", "doc": "spec", "kind": "engine_power_kw", "value": 700, "unit": "kW", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The diesel engines should meet EU emission stage IIIB as a minimum.", "doc": "spec", "kind": "emission_stage", "value": "IIIB", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "It must be fully operational at ambient temperatures between -30 °C and +35 °C.", "doc": "spec", "kind": "ambient_temperature", "value": [-30, 35], "unit": "°C", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Fire protection must meet hazard level HL2 according to EN 45545-2.", "doc": "spec", "kind": "fire_protection_level", "value": "HL2", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 45545-2"]},
    {"text": "The noise level in the driver's cab should not exceed 80 dB(A).", "doc": "spec", "kind": "noise_dba", "value": 80, "unit": "dB(A)", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The contracting authority requires a technical availability of at least 97 % over the warranty period.", "doc": "spec", "kind": "availability_percent", "value": 97, "unit": "%", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "It is desirable that the train can operate on gradients of up to 35 ‰.", "doc": "spec", "kind": "gradient_permille", "value": 35, "unit": "‰", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The vehicle shall be approved in accordance with EN 14033-1.", "doc": "spec", "kind": "norm", "value": "EN 14033-1", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 14033-1"]},
    {"text": "Wheel profiles should comply with EN 13715.", "doc": "spec", "kind": "norm", "value": "EN 13715", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 13715"]},
    {"text": "The supplier shall demonstrate RAMS management in accordance with EN 50126-1.", "doc": "spec", "kind": "norm", "value": "EN 50126-1", "unit": null, "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": ["EN 50126-1"]},
    {"text": "Delivery shall take place no later than 48 weeks after contract award.", "doc": "spec", "kind": "delivery_weeks", "value": 48, "unit": "weeks", "priority": "mandatory", "verdict": "clarify", "severity": "major", "red_flag": true, "norms": []},
    {"text": "The warranty period is 36 months from acceptance.", "doc": "spec", "kind": "warranty_months", "value": 36, "unit": "months", "priority": "mandatory", "verdict": "clarify", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Liquidated damages for late delivery amount to 0.5 % of the contract price per week, capped at 10 % of the contract price.", "doc": "spec", "kind": "penalty_cap_percent", "value": 10, "unit": "%", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "The supplier's total liability is limited to twice the contract value.", "doc": "spec", "kind": "liability", "value": "double_contract_value", "unit": null, "priority": "mandatory", "verdict": "clarify", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Invoices will be paid within 60 days of receipt.", "doc": "spec", "kind": "payment_days", "value": 60, "unit": "days", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Documentation should preferably be supplied in English.", "doc": "spec", "kind": "documentation_language", "value": "en", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Tenders must remain valid for 120 days after the submission deadline.", "doc": "spec", "kind": "bid_validity_days", "value": 120, "unit": "days", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Tenders must be submitted electronically via the procurement portal by 15 February 2027, 12:00 CET.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Bidders shall provide at least two references for rail grinding machines delivered within the last eight years.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Proof of product liability insurance with a minimum cover of EUR 10 million must be enclosed with the tender.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []}
  ],
  "norms": {"EN 45545-2": "certified", "EN 14033-1": "certified", "EN 13715": "certified", "EN 50126-1": "not_certified"},
  "bid": "bid",
  "variant": "GW Schleif 16"
}
