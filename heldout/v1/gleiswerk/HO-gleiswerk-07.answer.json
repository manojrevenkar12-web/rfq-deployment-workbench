{
  "id": "HO-gleiswerk-07",
  "customer": "gleiswerk",
  "language": "en",
  "subject": "Procurement of a tamping machine for plain line and switches",
  "requirements": [
    {"text": "The machine shall be built for standard gauge track (1,435 mm).", "doc": "spec", "kind": "track_gauge_mm", "value": 1435, "unit": "mm", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The maximum permitted axle load is 22.5 tonnes.", "doc": "spec", "kind": "axle_load_t", "value": 22.5, "unit": "t", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The minimum self-propelled travel speed is 100 km/h.", "doc": "spec", "kind": "travel_speed_kmh", "value": 100, "unit": "km/h", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Installed engine power shall be not less than 600 kW.", "doc": "spec", "kind": "engine_power_kw", "value": 600, "unit": "kW", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Engines shall meet emission stage V.", "doc": "spec", "kind": "emission_stage", "value": "V", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The machine must be fully operational in ambient temperatures from -40 °C to +30 °C.", "doc": "spec", "kind": "ambient_temperature", "value": [-40, 30], "unit": "°C", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "The machine shall achieve a technical availability of at least 98 % during the winter season.", "doc": "spec", "kind": "availability_percent", "value": 98, "unit": "%", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Fire protection should meet EN 45545-2 hazard level HL1.", "doc": "spec", "kind": "fire_protection_level", "value": "HL1", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 45545-2"]},
    {"text": "Cab noise should be kept below 78 dB(A).", "doc": "spec", "kind": "noise_dba", "value": 78, "unit": "dB(A)", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The machine should be able to work on gradients of up to 30 per mille.", "doc": "spec", "kind": "gradient_permille", "value": 30, "unit": "‰", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The machine shall comply with EN 14033-1 and be authorised accordingly.", "doc": "spec", "kind": "norm", "value": "EN 14033-1", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 14033-1"]},
    {"text": "On-board electronic equipment shall conform to EN 50155.", "doc": "spec", "kind": "norm", "value": "EN 50155", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 50155"]},
    {"text": "Welding should be performed in accordance with EN 15085-2.", "doc": "spec", "kind": "norm", "value": "EN 15085-2", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 15085-2"]},
    {"text": "Delivery is required within 12 months of the contract award.", "doc": "spec", "kind": "delivery_weeks", "value": 52, "unit": "weeks", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The supplier shall provide a full warranty of 60 months.", "doc": "spec", "kind": "warranty_months", "value": 60, "unit": "months", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Liquidated damages for delay of 0.5 % of the contract value per week shall apply without an upper limit.", "doc": "spec", "kind": "penalty_cap_percent", "value": null, "unit": "%", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Payment will be made within 30 days of invoice.", "doc": "spec", "kind": "payment_days", "value": 30, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Training of six days for operators and maintenance staff shall be included.", "doc": "spec", "kind": "training_days", "value": 6, "unit": "days", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Spare parts must remain available for at least 15 years.", "doc": "spec", "kind": "spare_parts_years", "value": 15, "unit": "years", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Documentation should be supplied in English.", "doc": "spec", "kind": "documentation_language", "value": "en", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Tenders shall be submitted electronically by 26 February 2027.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Bidders must submit a list of at least three reference machines in operation in climates with winter temperatures below -25 °C.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Tenders shall remain binding for 90 days.", "doc": "spec", "kind": "bid_validity_days", "value": 90, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []}
  ],
  "norms": {"EN 45545-2": "certified", "EN 14033-1": "certified", "EN 50155": "certified", "EN 15085-2": "certified"},
  "bid": "bid",
  "variant": "GW Stopf 08"
}
