{
  "id": "HO-gleiswerk-04",
  "customer": "gleiswerk",
  "language": "de",
  "subject": "Beschaffung einer Weichen- und Streckenstopfmaschine",
  "requirements": [
    {"text": "Die Maschine ist für Normalspur auszulegen.", "doc": "spec", "kind": "track_gauge_mm", "value": 1435, "unit": "mm", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die zulässige Radsatzlast beträgt höchstens 21 t.", "doc": "spec", "kind": "axle_load_t", "value": 21, "unit": "t", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "In Eigenfahrt muss die Maschine mindestens 100 km/h erreichen.", "doc": "spec", "kind": "travel_speed_kmh", "value": 100, "unit": "km/h", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Wünschenswert wäre eine Höchstgeschwindigkeit von 120 km/h, damit die Maschine auf den Hauptstrecken im Regelverkehr mitlaufen kann.", "doc": "spec", "kind": "travel_speed_kmh", "value": 120, "unit": "km/h", "priority": "desirable", "verdict": "deviate", "severity": "minor", "red_flag": true, "norms": []},
    {"text": "Die Antriebsleistung muss mindestens 0,55 MW betragen.", "doc": "spec", "kind": "engine_power_kw", "value": 550, "unit": "kW", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Motoren sollen mindestens die Abgasstufe IIIB erfüllen.", "doc": "spec", "kind": "emission_stage", "value": "IIIB", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Maschine muss zwischen -25 °C und +45 °C betrieben werden können.", "doc": "spec", "kind": "ambient_temperature", "value": [-25, 45], "unit": "°C", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Lärmpegel im Führerhaus darf höchstens 76 dB(A) betragen.", "doc": "spec", "kind": "noise_dba", "value": 76, "unit": "dB(A)", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Auftraggeber fordert eine mittlere technische Verfügbarkeit von mindestens 96 %.", "doc": "spec", "kind": "availability_percent", "value": 96, "unit": "%", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Brandschutzausführung hat mindestens der Gefährdungsstufe HL1 nach EN 45545-2 zu entsprechen.", "doc": "spec", "kind": "fire_protection_level", "value": "HL1", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 45545-2"]},
    {"text": "Steigungen bis 40 Promille sollten im Arbeitsbetrieb bewältigt werden können.", "doc": "spec", "kind": "gradient_permille", "value": 40, "unit": "‰", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Bauart muss der EN 14033-1 entsprechen.", "doc": "spec", "kind": "norm", "value": "EN 14033-1", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 14033-1"]},
    {"text": "Für die elektronische Ausrüstung sollte die EN 50155 eingehalten werden.", "doc": "spec", "kind": "norm", "value": "EN 50155", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 50155"]},
    {"text": "Die Einhaltung der TSI NOI ist wünschenswert.", "doc": "spec", "kind": "norm", "value": "TSI NOI", "unit": null, "priority": "desirable", "verdict": "deviate", "severity": "minor", "red_flag": true, "norms": ["TSI NOI"]},
    {"text": "Liefertermin: spätestens 12 Monate nach Zuschlag.", "doc": "spec", "kind": "delivery_weeks", "value": 52, "unit": "weeks", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Mängelansprüche verjähren in 24 Monaten ab Abnahme.", "doc": "spec", "kind": "warranty_months", "value": 24, "unit": "months", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Bei Terminüberschreitung wird eine Vertragsstrafe in Höhe von 0,1 % je Arbeitstag erhoben, begrenzt auf 8 % der Auftragssumme.", "doc": "spec", "kind": "penalty_cap_percent", "value": 8, "unit": "%", "priority": "mandatory", "verdict": "clarify", "severity": "major", "red_flag": true, "norms": []},
    {"text": "Die Zahlung erfolgt 30 Tage nach Rechnungseingang.", "doc": "spec", "kind": "payment_days", "value": 30, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Ersatzteile müssen über einen Zeitraum von 20 Jahren lieferbar sein.", "doc": "spec", "kind": "spare_parts_years", "value": 20, "unit": "years", "priority": "mandatory", "verdict": "deviate", "severity": "minor", "red_flag": true, "norms": []},
    {"text": "Der Auftragnehmer hat Schulungen im Umfang von insgesamt acht Tagen für Bediener und Werkstatt durchzuführen.", "doc": "spec", "kind": "training_days", "value": 8, "unit": "days", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Haftung ist auf einen Betrag von 2,5 Mio. EUR begrenzt.", "doc": "spec", "kind": "liability", "value": "limited", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Das Angebot ist bis zum 28.01.2027 elektronisch einzureichen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Der Bieter hat einen Nachweis über eine Betriebshaftpflichtversicherung mit einer Deckungssumme von mindestens 5 Mio. EUR vorzulegen.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Die Bindefrist endet 100 Tage nach Ablauf der Angebotsfrist.", "doc": "spec", "kind": "bid_validity_days", "value": 100, "unit": "days", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []}
  ],
  "norms": {"EN 45545-2": "certified", "EN 14033-1": "certified", "EN 50155": "certified", "TSI NOI": "not_certified"},
  "bid": "bid",
  "variant": "GW Stopf 08"
}
