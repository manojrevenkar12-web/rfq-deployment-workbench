{
  "id": "HO-gleiswerk-05",
  "customer": "gleiswerk",
  "language": "en",
  "subject": "Road-rail excavator for track maintenance",
  "requirements": [
    {"text": "The rail running gear must be suitable for the Irish track gauge of 1600 mm.", "doc": "spec", "kind": "track_gauge_mm", "value": 1600, "unit": "mm", "priority": "mandatory", "verdict": "deviate", "severity": "knockout", "red_flag": true, "norms": []},
    {"text": "The maximum permissible axle load on rail is 18 t.", "doc": "spec", "kind": "axle_load_t", "value": 18, "unit": "t", "priority": "mandatory", "verdict": "clarify", "severity": null, "red_flag": false, "norms": []},
    {"text": "The machine shall travel on rail at a speed of at least 25 km/h.", "doc": "spec", "kind": "travel_speed_kmh", "value": 25, "unit": "km/h", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Engine power should be no less than 120 kW.", "doc": "spec", "kind": "engine_power_kw", "value": 120, "unit": "kW", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The engine must comply with EU Stage V.", "doc": "spec", "kind": "emission_stage", "value": "V", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The machine shall be operable at ambient temperatures from -15 °C to +35 °C.", "doc": "spec", "kind": "ambient_temperature", "value": [-15, 35], "unit": "°C", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Gradients of up to 20 ‰ must be negotiated with a fully loaded bucket.", "doc": "spec", "kind": "gradient_permille", "value": 20, "unit": "‰", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Noise at the operator's position shall not exceed 78 dB(A).", "doc": "spec", "kind": "noise_dba", "value": 78, "unit": "dB(A)", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "A technical availability of 95 % is desirable.", "doc": "spec", "kind": "availability_percent", "value": 95, "unit": "%", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "The machine must be certified to EN 15746-1.", "doc": "spec", "kind": "norm", "value": "EN 15746-1", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 15746-1"]},
    {"text": "Compliance with EN 15746-2 is mandatory.", "doc": "spec", "kind": "norm", "value": "EN 15746-2", "unit": null, "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": ["EN 15746-2"]},
    {"text": "Welding of the rail gear frame should be carried out to EN 15085-2.", "doc": "spec", "kind": "norm", "value": "EN 15085-2", "unit": null, "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": ["EN 15085-2"]},
    {"text": "The machine shall be delivered within 9 months of contract award.", "doc": "spec", "kind": "delivery_weeks", "value": 39, "unit": "weeks", "priority": "mandatory", "verdict": "deviate", "severity": "major", "red_flag": true, "norms": []},
    {"text": "A warranty of 24 months is required.", "doc": "spec", "kind": "warranty_months", "value": 24, "unit": "months", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Delay damages are payable at 1 % of the contract price per week of delay up to a maximum of 5 %.", "doc": "spec", "kind": "penalty_cap_percent", "value": 5, "unit": "%", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Payment terms are 30 days from the date of a valid invoice.", "doc": "spec", "kind": "payment_days", "value": 30, "unit": "days", "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Operator training of four days should be included.", "doc": "spec", "kind": "training_days", "value": 4, "unit": "days", "priority": "desirable", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "All manuals shall be provided in English.", "doc": "spec", "kind": "documentation_language", "value": "en", "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Tenders shall be submitted via the electronic tender portal no later than 12:00 on 4 March 2027.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "Tenderers must provide evidence of public liability insurance of not less than EUR 6.5 million.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []},
    {"text": "At least two references for road-rail machines supplied to European infrastructure managers shall be included.", "doc": "spec", "kind": "procedural", "value": null, "unit": null, "priority": "mandatory", "verdict": "comply", "severity": null, "red_flag": false, "norms": []}
  ],
  "norms": {"EN 15746-1": "certified", "EN 15746-2": "not_certified", "EN 15085-2": "certified"},
  "bid": "no_bid",
  "variant": "GW ZW 2"
}
